			calculationItem 'Δ Plan Monat %' = ```
					// Zweck: Abweichung zum Plan Monat im Verhältnis zum Plan. Bei der Rohertragsmarge und ohne Plan leer.
					// Quelle: DIVIDE der Differenz durch den Plan Monat. Format 0,0 %. Vorzeichen ist die relative Differenz.
					VAR Aktuell =
						CALCULATE (
							SELECTEDMEASURE (),
							Zeitauswahl[Zeitauswahl] = "Monat"
						)
					VAR Plan =
						CALCULATE (
							SELECTEDMEASURE (),
							Zeitauswahl[Zeitauswahl] = "Plan (Demo) Monat"
						)
					RETURN
						IF (
							OR (
								ISSELECTEDMEASURE ( [Rohertragsmarge] ),
								ISSELECTEDMEASURE (
									[Offene Forderungen],
									[Verbindlichkeiten],
									[Bestandswert],
									[Endsaldo Bericht],
									[Saldenliste Bewegung],
									[Abstimmung Bericht],
									[Abstimmung Saldenliste],
									[Abstimmung Differenz],
									[Abstimmung Status]
								)
							),
							BLANK (),
							DIVIDE ( Aktuell - Plan, Plan )
						)
					```
				ordinal: 14
				formatStringDefinition = "0.0%"


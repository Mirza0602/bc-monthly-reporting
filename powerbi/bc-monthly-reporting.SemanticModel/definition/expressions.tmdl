expression pMandant =
		// Parameter Text. Standard CRONUS DE. Firmenname, keine Company-ID.
		"CRONUS DE" meta [
		    IsParameterQuery = true,
		    Type = "Text",
		    IsParameterQueryRequired = true
		]
	lineageTag: f7bc3b9b-6dc5-4acb-b5dc-a924017af8ac


table DimDatum
	lineageTag: 95fdebd6-c07d-4e28-9ebc-772847a472c6
	dataCategory: Time

	column Datum
		dataType: dateTime
		isKey
		formatString: dd.mm.yyyy
		lineageTag: a40d2bf3-a6ad-4219-8ce8-5dc1973b4832
		summarizeBy: none
		sourceColumn: Datum

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column Jahr
		dataType: int64
		formatString: 0
		lineageTag: a0c7e801-f3ae-4fd4-ad9e-8247bcd3964e
		summarizeBy: sum
		sourceColumn: Jahr

		annotation SummarizationSetBy = Automatic

	column Monat
		dataType: int64
		formatString: 0
		lineageTag: 4df517fc-c34e-47c7-94d8-68a7274cdfd3
		summarizeBy: sum
		sourceColumn: Monat

		annotation SummarizationSetBy = Automatic

	column Monatsname
		dataType: string
		lineageTag: 1f03dcc7-c81d-454f-9b9e-0bc8a604b693
		summarizeBy: none
		sourceColumn: Monatsname
		sortByColumn: Monat

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column Quartal
		dataType: int64
		formatString: 0
		lineageTag: c6926eae-540c-4a75-a886-34551cbc6778
		summarizeBy: sum
		sourceColumn: Quartal

		annotation SummarizationSetBy = Automatic

	column Geschäftsjahr
		dataType: int64
		formatString: 0
		lineageTag: f9124b7b-07c2-4996-a540-66dad0f24804
		summarizeBy: sum
		sourceColumn: Geschäftsjahr

		annotation SummarizationSetBy = Automatic

	column IstAktuellerMonat
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 64bf6801-52a4-4fff-9fab-e74a33216219
		summarizeBy: none
		sourceColumn: IstAktuellerMonat

		annotation SummarizationSetBy = Automatic

	column Vorjahresdatum
		dataType: dateTime
		formatString: Long Date
		lineageTag: 85056f12-8880-419d-930b-0517518e73a5
		summarizeBy: none
		sourceColumn: Vorjahresdatum

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column MonatKey =
			// Jahr mal 100 plus Monat. Sortierschlüssel für Jahr-Monat.
			DimDatum[Jahr] * 100 + DimDatum[Monat]
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 95e863a0-a09e-4b94-88b5-69c65292f488
		summarizeBy: none

	column Jahr-Monat =
			// Text im Format yyyy-MM, sortiert über MonatKey.
			FORMAT ( DimDatum[Jahr], "0" ) & "-" & FORMAT ( DimDatum[Monat], "00" )
		dataType: string
		lineageTag: d4dccc9f-ada1-44c4-9c01-efcb1a10ccca
		summarizeBy: none
		sortByColumn: MonatKey

	column 'Im Trendfenster' =
			// 1, wenn das Datum nach dem Monatsende 13 Monate vor dem Stichtag liegt und höchstens am Monatsende des Stichtags.
			// Sonst 0. Das Measure [Im Trendfenster] bleibt im Modell und wird nicht mehr benutzt.
			IF ( DimDatum[Datum] > EOMONTH ( MAX ( pStichtag[pStichtag] ), -13 ) && DimDatum[Datum] <= EOMONTH ( MAX ( pStichtag[pStichtag] ), 0 ), 1, 0 )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 9d1012b2-ba28-4d42-93f3-c72966d5b06f
		summarizeBy: none

	partition DimDatum = m
		mode: import
		source =
				// Quelle: generiert, kein API-Abruf.
				// Filter: keiner. pStichtag filtert keine Zeile. IstAktuellerMonat vergleicht nur den Monat.
				// Schlüssel: Datum.
				// Erwartete Zeilenzahl: 1461
				// Abweichung von B2: fester Bereich 01.01.2024 bis 31.12.2027, nicht ab dem ersten Posten bis Ende Folgejahr. Geschäftsjahr ist das Kalenderjahr, dateSetup ist nicht im Katalog.
				let
				    Start = #date(2024, 1, 1),
				    Ende = #date(2027, 12, 31),
				    Tage = List.Dates(Start, Duration.Days(Ende - Start) + 1, #duration(1, 0, 0, 0)),
				    Basis = Table.FromList(Tage, Splitter.SplitByNothing(), {"Datum"}, null, ExtraValues.Error),
				    Monatsnamen = {
				        "Januar",
				        "Februar",
				        "März",
				        "April",
				        "Mai",
				        "Juni",
				        "Juli",
				        "August",
				        "September",
				        "Oktober",
				        "November",
				        "Dezember"
				    },
				    MitJahr = Table.AddColumn(Basis, "Jahr", each Date.Year([Datum]), Int64.Type),
				    MitMonat = Table.AddColumn(MitJahr, "Monat", each Date.Month([Datum]), Int64.Type),
				    MitName = Table.AddColumn(
				        MitMonat,
				        "Monatsname",
				        each Monatsnamen{Date.Month([Datum]) - 1},
				        type text
				    ),
				    MitQuartal = Table.AddColumn(
				        MitName,
				        "Quartal",
				        each Date.QuarterOfYear([Datum]),
				        Int64.Type
				    ),
				    MitGeschaeftsjahr = Table.AddColumn(
				        MitQuartal,
				        "Geschäftsjahr",
				        each Date.Year([Datum]),
				        Int64.Type
				    ),
				    MitAktuell = Table.AddColumn(
				        MitGeschaeftsjahr,
				        "IstAktuellerMonat",
				        each Date.Year([Datum]) = Date.Year(pStichtag) and Date.Month([Datum]) = Date.Month(pStichtag),
				        type logical
				    ),
				    MitVorjahr = Table.AddColumn(
				        MitAktuell,
				        "Vorjahresdatum",
				        each Date.AddYears([Datum], -1),
				        type date
				    ),
				    Typisiert = Table.TransformColumnTypes(MitVorjahr, {{"Datum", type date}})
				in
				    Typisiert

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table


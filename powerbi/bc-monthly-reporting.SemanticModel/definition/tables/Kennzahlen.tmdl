	measure 'Im Trendfenster' =
			// Zweck: Liefert 1, wenn der letzte Tag im Filter nach dem Monatsende 13 Monate vor dem Stichtag liegt und höchstens am Monatsende des Stichtags. Sonst leer. Visual-Filter ist 1.
			// Quelle: [Stichtag] und MAX von DimDatum[Datum]. Der Slicer wird nicht gelesen. Vorzeichen keines.
			VAR Stich = [Stichtag]
			VAR Letzter = MAX ( DimDatum[Datum] )
			VAR Untergrenze = EOMONTH ( Stich, -13 )
			VAR Obergrenze = EOMONTH ( Stich, 0 )
			RETURN
				IF (
					NOT ISBLANK ( Letzter )
						&& Letzter > Untergrenze
						&& Letzter <= Obergrenze,
					1
				)
		formatString: 0
		displayFolder: '07 Karten'
		lineageTag: 8f5b7ce6-3d1c-428e-9f9d-f595ada31da4

	measure 'Brücke Wert' =
			// Zweck: Wert eines Schritts der GuV-Brücke. Die Summe der Schritte ist der EBIT, der Wasserfall zeigt diese Summe als Total.
			// Quelle: SWITCH auf Bruecke[Schritt]. Vorzeichen dreht bei Wareneinsatz, Betriebsaufwand und Abschreibung.
			SWITCH (
				SELECTEDVALUE ( Bruecke[Schritt] ),
				"Umsatz", [Umsatz],
				"Wareneinsatz", - [Wareneinsatz],
				"Betriebsaufwand", - [Betriebsaufwand],
				"Abschreibung", - [Abschreibung],
				"Sonstiger Ertrag und Aufwand", [Sonstiger Ertrag und Aufwand]
			)
		formatString: #,0
		displayFolder: '07 Karten'
		lineageTag: 95527db5-b95d-46e2-bd66-a8fedf471196

	measure 'GuV Monat' =
			// Zweck: Wert der GuV-Zeile im Berichtsmonat. Jede Zeile bleibt die Definition aus 01 Basis.
			// Quelle: SWITCH auf Abstimmzeile[Kennzahl], Basis mit Zeitauswahl Monat. Vorzeichen bleibt das der Zeile. Aufwand bleibt positiv.
			SWITCH (
				SELECTEDVALUE ( Abstimmzeile[Kennzahl] ),
				"Umsatz", CALCULATE ( [Umsatz], Zeitauswahl[Zeitauswahl] = "Monat" ),
				"Wareneinsatz", CALCULATE ( [Wareneinsatz], Zeitauswahl[Zeitauswahl] = "Monat" ),
				"Rohertrag", CALCULATE ( [Rohertrag], Zeitauswahl[Zeitauswahl] = "Monat" ),
				"Betriebsaufwand", CALCULATE ( [Betriebsaufwand], Zeitauswahl[Zeitauswahl] = "Monat" ),
				"Abschreibung", CALCULATE ( [Abschreibung], Zeitauswahl[Zeitauswahl] = "Monat" ),
				"Sonstiger Ertrag und Aufwand", CALCULATE ( [Sonstiger Ertrag und Aufwand], Zeitauswahl[Zeitauswahl] = "Monat" ),
				"EBIT", CALCULATE ( [EBIT], Zeitauswahl[Zeitauswahl] = "Monat" ),
				"Rohertragsmarge", CALCULATE ( [Rohertragsmarge], Zeitauswahl[Zeitauswahl] = "Monat" )
			)
		formatString: #,0
		displayFolder: '08 GuV Seite 2'
		lineageTag: 1ac8419c-9655-48f7-85ef-cb21024b038f

	measure 'GuV Vorjahr Monat' =
			// Zweck: Wert der GuV-Zeile im Vorjahresmonat. Dieselbe Definition wie im Berichtsmonat.
			// Quelle: SWITCH auf Abstimmzeile[Kennzahl], Basis mit Zeitauswahl Vorjahr Monat. Vorzeichen bleibt das der Zeile.
			SWITCH (
				SELECTEDVALUE ( Abstimmzeile[Kennzahl] ),
				"Umsatz", CALCULATE ( [Umsatz], Zeitauswahl[Zeitauswahl] = "Vorjahr Monat" ),
				"Wareneinsatz", CALCULATE ( [Wareneinsatz], Zeitauswahl[Zeitauswahl] = "Vorjahr Monat" ),
				"Rohertrag", CALCULATE ( [Rohertrag], Zeitauswahl[Zeitauswahl] = "Vorjahr Monat" ),
				"Betriebsaufwand", CALCULATE ( [Betriebsaufwand], Zeitauswahl[Zeitauswahl] = "Vorjahr Monat" ),
				"Abschreibung", CALCULATE ( [Abschreibung], Zeitauswahl[Zeitauswahl] = "Vorjahr Monat" ),
				"Sonstiger Ertrag und Aufwand", CALCULATE ( [Sonstiger Ertrag und Aufwand], Zeitauswahl[Zeitauswahl] = "Vorjahr Monat" ),
				"EBIT", CALCULATE ( [EBIT], Zeitauswahl[Zeitauswahl] = "Vorjahr Monat" ),
				"Rohertragsmarge", CALCULATE ( [Rohertragsmarge], Zeitauswahl[Zeitauswahl] = "Vorjahr Monat" )
			)
		formatString: #,0
		displayFolder: '08 GuV Seite 2'
		lineageTag: 3963abc7-b3ba-4fa2-b253-bd9777076725

	measure 'GuV Δ VJ' =
			// Zweck: Abweichung der GuV-Zeile zum Vorjahr Monat.
			// Quelle: SWITCH auf Abstimmzeile[Kennzahl], Basis mit Zeitauswahl Δ VJ Monat. Vorzeichen ist die Differenz.
			SWITCH (
				SELECTEDVALUE ( Abstimmzeile[Kennzahl] ),
				"Umsatz", CALCULATE ( [Umsatz], Zeitauswahl[Zeitauswahl] = "Δ VJ Monat" ),
				"Wareneinsatz", CALCULATE ( [Wareneinsatz], Zeitauswahl[Zeitauswahl] = "Δ VJ Monat" ),
				"Rohertrag", CALCULATE ( [Rohertrag], Zeitauswahl[Zeitauswahl] = "Δ VJ Monat" ),
				"Betriebsaufwand", CALCULATE ( [Betriebsaufwand], Zeitauswahl[Zeitauswahl] = "Δ VJ Monat" ),
				"Abschreibung", CALCULATE ( [Abschreibung], Zeitauswahl[Zeitauswahl] = "Δ VJ Monat" ),
				"Sonstiger Ertrag und Aufwand", CALCULATE ( [Sonstiger Ertrag und Aufwand], Zeitauswahl[Zeitauswahl] = "Δ VJ Monat" ),
				"EBIT", CALCULATE ( [EBIT], Zeitauswahl[Zeitauswahl] = "Δ VJ Monat" ),
				"Rohertragsmarge", CALCULATE ( [Rohertragsmarge], Zeitauswahl[Zeitauswahl] = "Δ VJ Monat" )
			)
		formatString: +#,0;-#,0;0
		displayFolder: '08 GuV Seite 2'
		lineageTag: 0e948432-433c-4dcf-8fec-261147fa80bd

	measure 'GuV Δ VJ %' =
			// Zweck: Prozentuale Abweichung der GuV-Zeile zum Vorjahr Monat.
			// Quelle: SWITCH auf Abstimmzeile[Kennzahl], Basis mit Zeitauswahl Δ VJ Monat %. DIVIDE durch den Vorjahresmonat, bei Vorjahr 0 leer. Die Rohertragsmarge bleibt leer.
			SWITCH (
				SELECTEDVALUE ( Abstimmzeile[Kennzahl] ),
				"Umsatz", CALCULATE ( [Umsatz], Zeitauswahl[Zeitauswahl] = "Δ VJ Monat %" ),
				"Wareneinsatz", CALCULATE ( [Wareneinsatz], Zeitauswahl[Zeitauswahl] = "Δ VJ Monat %" ),
				"Rohertrag", CALCULATE ( [Rohertrag], Zeitauswahl[Zeitauswahl] = "Δ VJ Monat %" ),
				"Betriebsaufwand", CALCULATE ( [Betriebsaufwand], Zeitauswahl[Zeitauswahl] = "Δ VJ Monat %" ),
				"Abschreibung", CALCULATE ( [Abschreibung], Zeitauswahl[Zeitauswahl] = "Δ VJ Monat %" ),
				"Sonstiger Ertrag und Aufwand", CALCULATE ( [Sonstiger Ertrag und Aufwand], Zeitauswahl[Zeitauswahl] = "Δ VJ Monat %" ),
				"EBIT", CALCULATE ( [EBIT], Zeitauswahl[Zeitauswahl] = "Δ VJ Monat %" ),
				"Rohertragsmarge", CALCULATE ( [Rohertragsmarge], Zeitauswahl[Zeitauswahl] = "Δ VJ Monat %" )
			)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: '08 GuV Seite 2'
		lineageTag: 8f03b5ee-4c82-4b78-bd1d-5ff0b889f19b

	measure 'GuV Plan (Demo) Monat' =
			// Zweck: Demo-Plan der GuV-Zeile im Berichtsmonat.
			// Quelle: SWITCH auf Abstimmzeile[Kennzahl], Basis mit Zeitauswahl Plan (Demo) Monat. Die Rohertragsmarge ruft [Rohertragsmarge] auf, der Plan bleibt die Vorjahresmarge.
			SWITCH (
				SELECTEDVALUE ( Abstimmzeile[Kennzahl] ),
				"Umsatz", CALCULATE ( [Umsatz], Zeitauswahl[Zeitauswahl] = "Plan (Demo) Monat" ),
				"Wareneinsatz", CALCULATE ( [Wareneinsatz], Zeitauswahl[Zeitauswahl] = "Plan (Demo) Monat" ),
				"Rohertrag", CALCULATE ( [Rohertrag], Zeitauswahl[Zeitauswahl] = "Plan (Demo) Monat" ),
				"Betriebsaufwand", CALCULATE ( [Betriebsaufwand], Zeitauswahl[Zeitauswahl] = "Plan (Demo) Monat" ),
				"Abschreibung", CALCULATE ( [Abschreibung], Zeitauswahl[Zeitauswahl] = "Plan (Demo) Monat" ),
				"Sonstiger Ertrag und Aufwand", CALCULATE ( [Sonstiger Ertrag und Aufwand], Zeitauswahl[Zeitauswahl] = "Plan (Demo) Monat" ),
				"EBIT", CALCULATE ( [EBIT], Zeitauswahl[Zeitauswahl] = "Plan (Demo) Monat" ),
				"Rohertragsmarge", CALCULATE ( [Rohertragsmarge], Zeitauswahl[Zeitauswahl] = "Plan (Demo) Monat" )
			)
		formatString: #,0
		displayFolder: '08 GuV Seite 2'
		lineageTag: d5c8f860-36a2-4488-aab3-4f9b7eea3e6e

	measure 'GuV Δ Plan' =
			// Zweck: Abweichung der GuV-Zeile zum Plan Monat.
			// Quelle: SWITCH auf Abstimmzeile[Kennzahl], Basis mit Zeitauswahl Δ Plan Monat. Bei der Rohertragsmarge sind das Prozentpunkte zur Vorjahresmarge.
			SWITCH (
				SELECTEDVALUE ( Abstimmzeile[Kennzahl] ),
				"Umsatz", CALCULATE ( [Umsatz], Zeitauswahl[Zeitauswahl] = "Δ Plan Monat" ),
				"Wareneinsatz", CALCULATE ( [Wareneinsatz], Zeitauswahl[Zeitauswahl] = "Δ Plan Monat" ),
				"Rohertrag", CALCULATE ( [Rohertrag], Zeitauswahl[Zeitauswahl] = "Δ Plan Monat" ),
				"Betriebsaufwand", CALCULATE ( [Betriebsaufwand], Zeitauswahl[Zeitauswahl] = "Δ Plan Monat" ),
				"Abschreibung", CALCULATE ( [Abschreibung], Zeitauswahl[Zeitauswahl] = "Δ Plan Monat" ),
				"Sonstiger Ertrag und Aufwand", CALCULATE ( [Sonstiger Ertrag und Aufwand], Zeitauswahl[Zeitauswahl] = "Δ Plan Monat" ),
				"EBIT", CALCULATE ( [EBIT], Zeitauswahl[Zeitauswahl] = "Δ Plan Monat" ),
				"Rohertragsmarge", CALCULATE ( [Rohertragsmarge], Zeitauswahl[Zeitauswahl] = "Δ Plan Monat" )
			)
		formatString: +#,0;-#,0;0
		displayFolder: '08 GuV Seite 2'
		lineageTag: e77ca9a3-9b2a-4a79-8c05-810b4de15352

	measure 'GuV YTD' =
			// Zweck: Wert der GuV-Zeile seit Jahresanfang. Dieselbe Definition wie im Berichtsmonat.
			// Quelle: SWITCH auf Abstimmzeile[Kennzahl], Basis mit Zeitauswahl YTD. Vorzeichen bleibt das der Zeile.
			SWITCH (
				SELECTEDVALUE ( Abstimmzeile[Kennzahl] ),
				"Umsatz", CALCULATE ( [Umsatz], Zeitauswahl[Zeitauswahl] = "YTD" ),
				"Wareneinsatz", CALCULATE ( [Wareneinsatz], Zeitauswahl[Zeitauswahl] = "YTD" ),
				"Rohertrag", CALCULATE ( [Rohertrag], Zeitauswahl[Zeitauswahl] = "YTD" ),
				"Betriebsaufwand", CALCULATE ( [Betriebsaufwand], Zeitauswahl[Zeitauswahl] = "YTD" ),
				"Abschreibung", CALCULATE ( [Abschreibung], Zeitauswahl[Zeitauswahl] = "YTD" ),
				"Sonstiger Ertrag und Aufwand", CALCULATE ( [Sonstiger Ertrag und Aufwand], Zeitauswahl[Zeitauswahl] = "YTD" ),
				"EBIT", CALCULATE ( [EBIT], Zeitauswahl[Zeitauswahl] = "YTD" ),
				"Rohertragsmarge", CALCULATE ( [Rohertragsmarge], Zeitauswahl[Zeitauswahl] = "YTD" )
			)
		formatString: #,0
		displayFolder: '08 GuV Seite 2'
		lineageTag: a105ad79-de1e-4ded-b986-fab0a7cb23cb

	measure 'GuV Δ VJ YTD' =
			// Zweck: Abweichung der GuV-Zeile zum Vorjahr seit Jahresanfang.
			// Quelle: SWITCH auf Abstimmzeile[Kennzahl], Basis mit Zeitauswahl Δ VJ YTD. Vorzeichen ist die Differenz.
			SWITCH (
				SELECTEDVALUE ( Abstimmzeile[Kennzahl] ),
				"Umsatz", CALCULATE ( [Umsatz], Zeitauswahl[Zeitauswahl] = "Δ VJ YTD" ),
				"Wareneinsatz", CALCULATE ( [Wareneinsatz], Zeitauswahl[Zeitauswahl] = "Δ VJ YTD" ),
				"Rohertrag", CALCULATE ( [Rohertrag], Zeitauswahl[Zeitauswahl] = "Δ VJ YTD" ),
				"Betriebsaufwand", CALCULATE ( [Betriebsaufwand], Zeitauswahl[Zeitauswahl] = "Δ VJ YTD" ),
				"Abschreibung", CALCULATE ( [Abschreibung], Zeitauswahl[Zeitauswahl] = "Δ VJ YTD" ),
				"Sonstiger Ertrag und Aufwand", CALCULATE ( [Sonstiger Ertrag und Aufwand], Zeitauswahl[Zeitauswahl] = "Δ VJ YTD" ),
				"EBIT", CALCULATE ( [EBIT], Zeitauswahl[Zeitauswahl] = "Δ VJ YTD" ),
				"Rohertragsmarge", CALCULATE ( [Rohertragsmarge], Zeitauswahl[Zeitauswahl] = "Δ VJ YTD" )
			)
		formatString: +#,0;-#,0;0
		displayFolder: '08 GuV Seite 2'
		lineageTag: 40a5f53f-b83d-481b-856a-715096613bea

	measure 'Kostenart Δ VJ' =
			// Zweck: Abweichung der Kostenart zum Vorjahr Monat für das Top 10. Das Visual trägt kein Zeitauswahl-Feld.
			// Quelle: [Betriebsaufwand] mit den Items Monat und Vorjahr Monat. Die Differenz setzt beide Items selbst. Aufwand bleibt positiv.
			VAR Aktuell =
				CALCULATE (
					[Betriebsaufwand],
					Zeitauswahl[Zeitauswahl] = "Monat"
				)
			VAR Vorjahr =
				CALCULATE (
					[Betriebsaufwand],
					Zeitauswahl[Zeitauswahl] = "Vorjahr Monat"
				)
			RETURN
				Aktuell - Vorjahr
		formatString: +#,0;-#,0;0
		displayFolder: '08 GuV Seite 2'
		lineageTag: b84f417f-faa1-4d01-a10b-7538c403eaaa

	measure 'GuV Signalrichtung' =
			// Zweck: Richtung der GuV-Zeile für die Signalfarbe. Die Regel steht nur hier.
			// Quelle: Abstimmzeile[Kennzahl]. Aufwand liefert 1, ein Anstieg ist ungünstig. Ertrag liefert -1, ein Rückgang ist ungünstig. Zeilen ohne Regel bleiben leer.
			SWITCH (
				SELECTEDVALUE ( Abstimmzeile[Kennzahl] ),
				"Wareneinsatz", 1,
				"Betriebsaufwand", 1,
				"Abschreibung", 1,
				"Umsatz", -1,
				"Rohertrag", -1,
				"EBIT", -1,
				"Sonstiger Ertrag und Aufwand", -1
			)
		formatString: 0
		isHidden
		displayFolder: '08 GuV Seite 2'
		lineageTag: b61c1d27-b043-47a2-92a3-a81ee1debeaa

	measure 'GuV Farbe VJ' =
			// Zweck: Signalfarbe der Abweichung zum Vorjahr. Nur eine ungünstige Abweichung wird Signal, sonst die Textfarbe.
			// Quelle: [GuV Δ VJ] mal [GuV Signalrichtung]. Blank und 0 bleiben #1E2733. Der Vergleich nutzt den Rohwert, nicht die Anzeige. 0,4 bleibt ungleich 0 und damit ungünstig, auch wenn das Format #,0 eine 0 zeigt.
			VAR Delta = [GuV Δ VJ]
			VAR Richtung = [GuV Signalrichtung]
			VAR HatAbweichung =
				NOT ISBLANK ( Richtung )
					&& NOT ISBLANK ( Delta )
					&& Delta <> 0
			RETURN
				IF ( HatAbweichung && Delta * Richtung > 0, "#A94F0A", "#1E2733" )
		displayFolder: '08 GuV Seite 2'
		lineageTag: 8b4e73d2-de01-4f8b-8f9c-594836d0e148

	measure 'GuV Farbe Plan' =
			// Zweck: Signalfarbe der Abweichung zum Plan. Dieselbe Regel wie bei [GuV Farbe VJ].
			// Quelle: [GuV Δ Plan] mal [GuV Signalrichtung]. Blank, 0 und der Rohwert 0,4 gelten wie bei [GuV Farbe VJ].
			VAR Delta = [GuV Δ Plan]
			VAR Richtung = [GuV Signalrichtung]
			VAR HatAbweichung =
				NOT ISBLANK ( Richtung )
					&& NOT ISBLANK ( Delta )
					&& Delta <> 0
			RETURN
				IF ( HatAbweichung && Delta * Richtung > 0, "#A94F0A", "#1E2733" )
		displayFolder: '08 GuV Seite 2'
		lineageTag: 43201d3f-1463-46b0-a91d-0b3b1333e219

	measure 'Forderungen Klasse' =
			// Zweck: Offene Forderungen zum Berichtsende in der Fälligkeitsklasse im Filter. Die Klassen zusammen sind die offenen Posten.
			// Quelle: FactDebitorenposten[Betrag] je Postennr, Buchungsdatum bis [Berichtsende], Rest ab 0,01, Fälligkeit je Postennr. Tage sind INT von Berichtsende minus Fälligkeit, von Faelligkeitsklasse[VonTage] bis [BisTage]. Der Filter auf Faelligkeitsklasse bleibt, REMOVEFILTERS trifft nur DimDatum. Vorzeichen wie in den Posten, Soll bleibt positiv. Leer bleibt leer.
			VAR Ende = [Berichtsende]
			VAR VonT = MIN ( Faelligkeitsklasse[VonTage] )
			VAR BisT = MAX ( Faelligkeitsklasse[BisTage] )
			RETURN
				CALCULATE (
					SUMX (
						FILTER (
							ADDCOLUMNS (
								VALUES ( FactDebitorenposten[Postennr] ),
								"@Rest", CALCULATE ( SUM ( FactDebitorenposten[Betrag] ) ),
								"@Faellig", CALCULATE ( MAX ( FactDebitorenposten[Fälligkeit] ) )
							),
							VAR Rest = [@Rest]
							VAR Faellig = [@Faellig]
							RETURN
								ABS ( Rest ) >= 0.01
									&& NOT ISBLANK ( Faellig )
									&& INT ( Ende - Faellig ) >= VonT
									&& INT ( Ende - Faellig ) <= BisT
						),
						[@Rest]
					),
					REMOVEFILTERS ( DimDatum ),
					DimDatum[Datum] <= Ende
				)
		formatString: #,0.00
		displayFolder: '09 Debitoren Kreditoren Seite 3'
		lineageTag: 8074feb5-a15e-47e9-a033-eaaa85d433ef

	measure 'Verbindlichkeiten Klasse' =
			// Zweck: Offene Verbindlichkeiten zum Berichtsende in der Fälligkeitsklasse im Filter, im Bericht positiv. Die Klassen zusammen sind die offenen Verbindlichkeiten.
			// Quelle: FactKreditorenposten[Betrag] je Postennr, Buchungsdatum bis [Berichtsende], Rest ab 0,01, Fälligkeit je Postennr. Tage wie bei [Forderungen Klasse]. Der Filter auf Faelligkeitsklasse bleibt, REMOVEFILTERS trifft nur DimDatum. Die Posten stehen im Haben. Mal minus 1 dreht das Vorzeichen und lässt einen leeren Wert leer.
			VAR Ende = [Berichtsende]
			VAR VonT = MIN ( Faelligkeitsklasse[VonTage] )
			VAR BisT = MAX ( Faelligkeitsklasse[BisTage] )
			VAR Summe =
				CALCULATE (
					SUMX (
						FILTER (
							ADDCOLUMNS (
								VALUES ( FactKreditorenposten[Postennr] ),
								"@Rest", CALCULATE ( SUM ( FactKreditorenposten[Betrag] ) ),
								"@Faellig", CALCULATE ( MAX ( FactKreditorenposten[Fälligkeit] ) )
							),
							VAR Rest = [@Rest]
							VAR Faellig = [@Faellig]
							RETURN
								ABS ( Rest ) >= 0.01
									&& NOT ISBLANK ( Faellig )
									&& INT ( Ende - Faellig ) >= VonT
									&& INT ( Ende - Faellig ) <= BisT
						),
						[@Rest]
					),
					REMOVEFILTERS ( DimDatum ),
					DimDatum[Datum] <= Ende
				)
			RETURN
				Summe * -1
		formatString: #,0.00
		displayFolder: '09 Debitoren Kreditoren Seite 3'
		lineageTag: beb72283-a72f-41a2-a079-8d272085bb22

	measure 'Verbindlichkeiten überfällig' =
			// Zweck: Offene Verbindlichkeiten zum Berichtsende, deren Fälligkeit vor dem Berichtsende liegt, im Bericht positiv. Ein Posten, der am Berichtsende fällig ist, zählt nicht.
			// Quelle: FactKreditorenposten[Betrag] je Postennr, Buchungsdatum bis [Berichtsende], Rest ab 0,01, Fälligkeit je Postennr aus FactKreditorenposten[Fälligkeit]. Die Posten stehen im Haben. Mal minus 1 dreht das Vorzeichen und lässt einen leeren Wert leer.
			VAR Bis = [Berichtsende]
			VAR Summe =
				CALCULATE (
					SUMX (
						FILTER (
							ADDCOLUMNS (
								VALUES ( FactKreditorenposten[Postennr] ),
								"@Rest", CALCULATE ( SUM ( FactKreditorenposten[Betrag] ) ),
								"@Faellig", CALCULATE ( MAX ( FactKreditorenposten[Fälligkeit] ) )
							),
							VAR Rest = [@Rest]
							VAR Faellig = [@Faellig]
							RETURN
								ABS ( Rest ) >= 0.01
									&& NOT ISBLANK ( Faellig )
									&& Faellig < Bis
						),
						[@Rest]
					),
					REMOVEFILTERS ( DimDatum ),
					DimDatum[Datum] <= Bis
				)
			RETURN
				Summe * -1
		formatString: #,0.00
		displayFolder: '09 Debitoren Kreditoren Seite 3'
		lineageTag: 95c9d6d5-8e37-444d-b9d7-d8322c3d618b

	measure 'Verbindlichkeiten Überfällig Anteil' =
			// Zweck: Anteil der überfälligen offenen Verbindlichkeiten an den offenen Verbindlichkeiten.
			// Quelle: DIVIDE von [Verbindlichkeiten überfällig] durch [Verbindlichkeiten]. Vorzeichen bleibt das der Beträge.
			DIVIDE ( [Verbindlichkeiten überfällig], [Verbindlichkeiten] )
		formatString: 0.0%
		displayFolder: '09 Debitoren Kreditoren Seite 3'
		lineageTag: b1c59d3a-f0eb-4677-9000-6e2587006185

	measure 'Verkauf Umsatz' =
			// Zweck: Umsatz der Verkaufszeilen im Filterkontext. Monat und YTD benutzen diese Definition.
			// Quelle: Summe FactWertposten[Verkaufsbetrag], Artikelpostenart Sale. Das sind die Verkaufszeilen. Vorzeichen wie in den Wertposten.
			CALCULATE (
				SUM ( FactWertposten[Verkaufsbetrag] ),
				FactWertposten[Artikelpostenart] = "Sale"
			)
		formatString: #,0.00
		displayFolder: '10 Kunden Artikel Seite 4'
		lineageTag: 7c1e9a24-6b50-4d8f-a3e1-5f2c8b0d6a47

	measure 'Verkauf Einstand' =
			// Zweck: Einstand der Verkaufszeilen im Filterkontext, im Bericht positiv.
			// Quelle: Summe FactWertposten[EinstandsbetragTatsächlich], Artikelpostenart Sale. Der Einstand steht in den Wertposten negativ. Mal minus 1 dreht das Vorzeichen und lässt einen leeren Wert leer.
			VAR Summe =
				CALCULATE (
					SUM ( FactWertposten[EinstandsbetragTatsächlich] ),
					FactWertposten[Artikelpostenart] = "Sale"
				)
			RETURN
				Summe * -1
		formatString: #,0.00
		displayFolder: '10 Kunden Artikel Seite 4'
		lineageTag: 2a8f4c61-9e17-4b3d-8c52-0d6e7a1b4f93

	measure 'DB I' =
			// Zweck: Deckungsbeitrag I im Filterkontext. Der Deckungsbeitrag aus den Warenwertposten ist der Rohertrag aus der Buchhaltung.
			// Quelle: [Verkauf Umsatz] minus [Verkauf Einstand]. Vorzeichen steckt in den Bausteinen.
			[Verkauf Umsatz] - [Verkauf Einstand]
		formatString: #,0.00
		displayFolder: '10 Kunden Artikel Seite 4'
		lineageTag: 5e0b7d38-1c64-4a9f-b2d7-8e3f6a0c5b14

	measure 'DB I Marge' =
			// Zweck: Deckungsbeitrag I im Verhältnis zum Verkaufsumsatz.
			// Quelle: DIVIDE von [DB I] durch [Verkauf Umsatz]. Vorzeichen steckt in den Bausteinen.
			DIVIDE ( [DB I], [Verkauf Umsatz] )
		formatString: 0.0%
		displayFolder: '10 Kunden Artikel Seite 4'
		lineageTag: 9d4a2e70-8f15-4c6b-9a38-7b1d0e5c2f46

	measure 'Verkauf Umsatz YTD' =
			// Zweck: Verkaufsumsatz seit Jahresanfang. Das Visual trägt kein Zeitauswahl-Feld.
			// Quelle: [Verkauf Umsatz] mit Zeitauswahl YTD. Vorzeichen bleibt das des Umsatzes.
			CALCULATE ( [Verkauf Umsatz], Zeitauswahl[Zeitauswahl] = "YTD" )

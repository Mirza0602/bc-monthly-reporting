	measure 'DB I YTD' =
			// Zweck: Deckungsbeitrag I seit Jahresanfang. Das Visual trägt kein Zeitauswahl-Feld.
			// Quelle: [DB I] mit Zeitauswahl YTD. Vorzeichen bleibt das des Deckungsbeitrags.
			CALCULATE ( [DB I], Zeitauswahl[Zeitauswahl] = "YTD" )
